{
  "name": "site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/site/src",
  "tags": [],
  "targets": {
    "build-content": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build-content.mjs",
        "cwd": "apps/site"
      }
    },
    "build-og": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-content"],
      "options": {
        "command": "node scripts/build-og-images.mjs",
        "cwd": "apps/site"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["build-content", "build-og"],
      "options": {
        "outputPath": "dist/apps/site",
        "browser": "apps/site/src/main.ts",
        "tsConfig": "apps/site/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/site/public"
          }
        ],
        "styles": ["apps/site/src/styles.css"],
        "server": "apps/site/src/main.server.ts",
        "ssr": {
          "entry": "apps/site/src/server.ts"
        },
        "outputMode": "static"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "dependsOn": ["build-content"],
      "configurations": {
        "production": {
          "buildTarget": "site:build:production"
        },
        "development": {
          "buildTarget": "site:build:development"
        }
      }
    },
    "copy-404": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "node scripts/copy-404.mjs", "cwd": "apps/site" }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/site/jest.config.cts",
        "tsConfig": "apps/site/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "site:build",
        "port": 4200,
        "staticFilePath": "dist/apps/site/browser",
        "spa": true
      }
    }
  }
}
