{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "paths": {
      "@ngx-runtime-i18n/angular": [
        "dist/libs/runtime-i18n-angular/index.d.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
