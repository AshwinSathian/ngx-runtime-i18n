{
  "name": "@ngx-runtime-i18n/source",
  "version": "2.0.1",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/*"
  ],
  "scripts": {
    "build:libs": "nx run-many -t build -p=runtime-i18n,runtime-i18n-angular,runtime-i18n-primeng,runtime-i18n-material --configuration=production --parallel",
    "build:tooling": "nx run-many -t build -p=runtime-i18n-schematics,cli --parallel",
    "test": "nx run-many -t test -p=runtime-i18n,runtime-i18n-angular,runtime-i18n-primeng,runtime-i18n-material,runtime-i18n-schematics,cli",
    "ci": "nx run-many -t build,test -p=runtime-i18n,runtime-i18n-angular,runtime-i18n-primeng,runtime-i18n-material,runtime-i18n-schematics,cli --configuration=production",
    "pack:core": "cd dist/libs/runtime-i18n && npm pack",
    "pack:angular": "cd dist/libs/runtime-i18n-angular && npm pack",
    "pack:primeng": "cd dist/libs/runtime-i18n-primeng && npm pack",
    "pack:material": "cd dist/libs/runtime-i18n-material && npm pack",
    "pack:schematics": "cd dist/libs/runtime-i18n-schematics && npm pack",
    "pack:cli": "cd tools/cli && npm pack",
    "publish:core:dry": "cd dist/libs/runtime-i18n && npm publish --dry-run",
    "publish:angular:dry": "cd dist/libs/runtime-i18n-angular && npm publish --dry-run",
    "publish:primeng:dry": "cd dist/libs/runtime-i18n-primeng && npm publish --dry-run",
    "publish:material:dry": "cd dist/libs/runtime-i18n-material && npm publish --dry-run",
    "publish:schematics:dry": "cd dist/libs/runtime-i18n-schematics && npm publish --dry-run",
    "publish:cli:dry": "cd tools/cli && npm publish --dry-run"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "20.3.33",
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/platform-browser": "20.3.27",
    "@angular/platform-browser-dynamic": "20.3.27",
    "@angular/platform-server": "20.3.27",
    "@angular/router": "20.3.27",
    "@angular/ssr": "20.3.33",
    "@ngx-runtime-i18n/angular": "^2.0.0",
    "@ngx-runtime-i18n/core": "^2.0.0",
    "express": "^4.21.2",
    "rxjs": "~7.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "20.3.33",
    "@angular-devkit/schematics": "20.3.33",
    "@angular/build": "20.3.33",
    "@angular/cdk": "^20.2.14",
    "@angular/cli": "20.3.33",
    "@angular/compiler-cli": "20.3.27",
    "@angular/language-service": "20.3.27",
    "@angular/material": "^20.2.14",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.1.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "20.3.33",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.8",
    "@swc/helpers": "~0.5.11",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "18.16.9",
    "@typescript-eslint/utils": "8.67.0",
    "angular-eslint": "^20.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "~14.6.1",
    "jest-util": "^29.7.0",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "^20.3.0",
    "nx": "23.1.1",
    "postcss": "^8.4.5",
    "postcss-url": "~10.1.3",
    "prettier": "^2.6.2",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.67.0",
    "verdaccio": "^6.0.5"
  },
  "nx": {
    "includedScripts": []
  },
  "overrides": {
    "@angular/common": "20.3.27"
  }
}
